ARG BASE_IMAGE=ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289
FROM ${BASE_IMAGE}

ARG TRIVY_VERSION=0.76.2
ARG ACTIONLINT_VERSION=1.7.12
ARG COSIGN_VERSION=3.1.4
ARG ORAS_VERSION=1.4.0
ARG CONFTEST_VERSION=0.71.1

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates curl docker.io git golang-go make python3 python3-pip python3-venv tar \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/nigu-ci
COPY requirements-ci.txt /tmp/requirements-ci.txt
RUN /opt/nigu-ci/bin/pip install --no-cache-dir -r /tmp/requirements-ci.txt
ENV PATH="/opt/nigu-ci/bin:${PATH}"

RUN set -eux; \
    archive="trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz"; \
    curl -fsSLo "/tmp/${archive}" \
      "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz"; \
    curl -fsSLo /tmp/trivy-checksums.txt \
      "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_checksums.txt"; \
    (cd /tmp && grep "trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz" trivy-checksums.txt | sha256sum -c -); \
    tar -xzf "/tmp/${archive}" -C /usr/local/bin trivy; \
    rm "/tmp/${archive}" /tmp/trivy-checksums.txt

RUN set -eux; \
    archive="actionlint_${ACTIONLINT_VERSION}_linux_amd64.tar.gz"; \
    curl -fsSLo "/tmp/${archive}" \
      "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_linux_amd64.tar.gz"; \
    curl -fsSLo /tmp/actionlint-checksums.txt \
      "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_checksums.txt"; \
    (cd /tmp && grep "actionlint_${ACTIONLINT_VERSION}_linux_amd64.tar.gz" actionlint-checksums.txt | sha256sum -c -); \
    tar -xzf "/tmp/${archive}" -C /usr/local/bin actionlint; \
    rm "/tmp/${archive}" /tmp/actionlint-checksums.txt

RUN set -eux; \
    curl -fsSLo /tmp/cosign-linux-amd64 \
      "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-amd64"; \
    curl -fsSLo /tmp/cosign-checksums.txt \
      "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign_checksums.txt"; \
    (cd /tmp && grep "cosign-linux-amd64$" cosign-checksums.txt | sha256sum -c -); \
    install -m 0755 /tmp/cosign-linux-amd64 /usr/local/bin/cosign; \
    rm /tmp/cosign-linux-amd64 /tmp/cosign-checksums.txt

RUN set -eux; \
    archive="oras_${ORAS_VERSION}_linux_amd64.tar.gz"; \
    curl -fsSLo "/tmp/${archive}" \
      "https://github.com/oras-project/oras/releases/download/v${ORAS_VERSION}/${archive}"; \
    curl -fsSLo /tmp/oras-checksums.txt \
      "https://github.com/oras-project/oras/releases/download/v${ORAS_VERSION}/oras_${ORAS_VERSION}_checksums.txt"; \
    (cd /tmp && grep " ${archive}$" oras-checksums.txt | sha256sum -c -); \
    tar -xzf "/tmp/${archive}" -C /usr/local/bin oras; \
    rm "/tmp/${archive}" /tmp/oras-checksums.txt

RUN set -eux; \
    archive="conftest_${CONFTEST_VERSION}_Linux_x86_64.tar.gz"; \
    curl -fsSLo "/tmp/${archive}" \
      "https://github.com/open-policy-agent/conftest/releases/download/v${CONFTEST_VERSION}/${archive}"; \
    curl -fsSLo /tmp/conftest-checksums.txt \
      "https://github.com/open-policy-agent/conftest/releases/download/v${CONFTEST_VERSION}/checksums.txt"; \
    (cd /tmp && grep " ${archive}$" conftest-checksums.txt | sha256sum -c -); \
    tar -xzf "/tmp/${archive}" -C /usr/local/bin conftest; \
    rm "/tmp/${archive}" /tmp/conftest-checksums.txt

COPY .pre-commit-config.yaml /tmp/pre-commit-config.yaml
ENV PRE_COMMIT_HOME=/opt/pre-commit-cache
ENV TRIVY_CACHE_DIR=/opt/trivy-cache
WORKDIR /opt/pre-commit
RUN git init -q \
    && cp /tmp/pre-commit-config.yaml .pre-commit-config.yaml \
    && pre-commit install-hooks

RUN trivy image --download-db-only
RUN mkdir /tmp/trivy-prewarm && printf 'FROM scratch\n' >/tmp/trivy-prewarm/Containerfile \
    && trivy config /tmp/trivy-prewarm
RUN mkdir -p /workspace /output /home/ubuntu \
    && chmod -R a+rwX /workspace /output /opt/pre-commit-cache /opt/trivy-cache /home/ubuntu \
    && chown -R 1000:1000 /workspace /output /home/ubuntu
ENV NIGU_BUILD_CONTAINER=1
ENV HOME=/home/ubuntu
USER 1000:1000
WORKDIR /workspace
HEALTHCHECK NONE
ENTRYPOINT ["/bin/bash", "-lc"]
