ARG BASE_IMAGE=ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289
FROM ${BASE_IMAGE}

ENV container=docker
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl docker.io openssh-server python3 sudo systemd systemd-sysv \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/ssh/ssh_host_*_key /etc/ssh/ssh_host_*_key.pub \
    && mkdir -p /run/sshd \
    && userdel -r ubuntu \
    && groupadd --gid 1000 ops \
    && useradd --uid 1000 --gid 1000 --create-home --home-dir /home/ops --shell /bin/bash ops \
    && usermod -aG docker ops \
    && install -d -m 0700 -o ops -g ops /home/ops/.ssh \
    && printf 'ops ALL=(root) NOPASSWD: ALL\n' >/etc/sudoers.d/local-operations \
    && chmod 0440 /etc/sudoers.d/local-operations \
    && sed -i 's/^#PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config \
    && sed -i 's/^#PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config \
    && sed -i 's/^#PubkeyAuthentication.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config \
    && chmod 0700 /home/ops/.ssh \
    && systemctl enable ssh docker

COPY entrypoint.sh /usr/local/bin/local-vps-entrypoint
RUN chmod 0755 /usr/local/bin/local-vps-entrypoint

EXPOSE 22 443
USER 1000:1000
HEALTHCHECK NONE
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/usr/local/bin/local-vps-entrypoint"]
CMD ["/sbin/init"]
