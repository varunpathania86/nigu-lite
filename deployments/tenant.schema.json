{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nigu.in/schemas/tenants/v1.json",
  "title": "Tenant definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "product",
    "display_name",
    "domains",
    "apps",
    "branding",
    "migrations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,30}$"},
    "product": {"enum": ["erp", "edu"]},
    "display_name": {"type": "string", "minLength": 1},
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "custom_domains"],
      "properties": {
        "primary": {"type": "string", "format": "hostname"},
        "custom_domains": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "format": "hostname"}
        }
      }
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["erpnext", "gibbon"]}
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logo", "header", "css"],
      "properties": {
        "logo": {"type": "string", "pattern": "^assets/"},
        "header": {"type": "string", "pattern": "^assets/"},
        "css": {"type": "string", "pattern": "^assets/"}
      }
    },
    "migrations": {"type": "string", "pattern": "^migrations/$"}
  }
}
